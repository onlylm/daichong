NODE_ENV=development
# disabled：禁止真实交易；controlled：白名单限额实单；production：后台通道启用后执行真实业务。
EXECUTION_MODE=disabled
HOST=127.0.0.1
PORT=3200
LOG_LEVEL=info
TRUST_PROXY=false
# 仅在 TRUST_PROXY=true 时生效。必须填写实际反向代理的来源网段，禁止使用 0.0.0.0/0 或 ::/0。
# 当前生产拓扑为宿主机 Caddy -> Docker 回环端口，发布脚本会写入回环与 Docker bridge 私网。
TRUSTED_PROXY_CIDRS=

# 开放 API 按 API Key 分别限制读取与写入请求；固定一分钟窗口，所有 API 进程共享数据库计数。
API_RATE_LIMIT_READ_PER_MINUTE=600
API_RATE_LIMIT_WRITE_PER_MINUTE=120

# 新平台专用 PostgreSQL/Redis；禁止填入现有 Quefa 生产连接串。
DATABASE_URL=postgresql://quefa_dev:replace-local-only@127.0.0.1:5433/quefa_open_dev
REDIS_URL=redis://127.0.0.1:6380/0

# 仅本地沙箱使用；生产必须 false。
ENABLE_SANDBOX_ROUTES=true
SANDBOX_ADMIN_TOKEN=replace-with-local-sandbox-token
# 仅 Quefa 内部充值供应管理使用；生产还必须配合内网/VPN、人员登录、MFA 与 RBAC。
PLATFORM_ADMIN_TOKEN=replace-platform-admin-token-at-least-32-characters

# 仅为本地演示种子数据；生产代理商/开放 API 密钥必须由受审计的后台创建。
DEMO_PARTNER_ID=pt_demo_a
DEMO_KEY_ID=key_demo_a_01
DEMO_CLIENT_SECRET=replace-with-demo-secret-at-least-32-chars

# 32 字节 Base64，仅新平台使用。生产从 KMS/Secret Manager 注入。
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
KEY_ENCRYPTION_KEY_ID=local-development-only

# Quefa 平台级支付配置，所有代理商共用；代理商不得配置支付账户。
# 本地默认 mock；生产使用 managed，并由后台分别验证、启用通道。
PAYMENT_PROVIDER=mock
# 新部署可设 managed：在 /workspace 的“支付设置”管理支付宝；平台不开放 USDT 新交易。
# 默认支付宝关闭，须在后台验证后启用。controlled 模式仍要求下述白名单和限额。
# managed 模式的支付凭据加密存入数据库，不需要填写下方支付宝文件参数；
# 从文件模式迁移且有旧支付宝订单时，必须保留原文件参数和密钥以核对旧单。
# 已开通当面付时使用 alipay_page（alipay.trade.precreate）；不是电脑网站支付。
# 下列私钥是“应用私钥”，公钥是“支付宝公钥”，不要填成应用公钥。
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=./secrets/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=./secrets/alipay-public.pem
ALIPAY_KEY_TYPE=PKCS8
# 真实付款要求白名单/限额、关闭 sandbox 路由、HTTPS、非默认密钥、独立 SQLite 文件。
LIVE_TEST_ENABLED=false
LIVE_TEST_PARTNER_IDS=
# 人民币分；统计当前数据库全部历史联调订单（含未支付/退款），不会自动重置。
LIVE_TEST_MAX_ORDER_MINOR=16000
LIVE_TEST_MAX_TOTAL_MINOR=32000
LIVE_TEST_MAX_ORDERS=2
# CDK 单次兑换资金上限，按上游 USD minor 注资口径；真实供应联调必须设正数。
ZOVOCARD_CDK_FUNDING_CAP_MINOR=0
FULFILLMENT_PROVIDER=mock
PUBLIC_BASE_URL=http://127.0.0.1:3200
# 独立后台入口；生产应使用单独子域名，开发可留空并回退到 PUBLIC_BASE_URL。
ADMIN_BASE_URL=
PORTAL_TOKEN_SECRET=replace-public-portal-secret-at-least-32-characters

# ZovoCard 仅由 Quefa 服务端调用。代理商和浏览器永远不得拿到这些配置。
ZOVOCARD_API_BASE=https://sandbox.zovocard.com/openapi/v1
ZOVOCARD_CDK_BASE=https://sandbox.zovocard.com/api/v1/cdk
ZOVOCARD_API_KEY=
ZOVOCARD_CARD_ID=
ZOVOCARD_WEBHOOK_SECRET=
# 只允许精确 HTTPS 主机名；不要填写协议、路径、端口、IP、通配符或内网域名。
SUPPLIER_ALLOWED_HOSTS=sandbox.zovocard.com,zovocard.com

# 代理商联调沙箱默认使用可跨 API/Worker 共享的 SQLite；memory 仅供单元测试。
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/quefa-sandbox.sqlite
BACKUP_HEALTH_REPORT_PATH=
# 每周恢复演练允许最多 8 天未更新；超时后后台显示已过期。
BACKUP_RESTORE_MAX_AGE_HOURS=192

# 代理商 Webhook 由 Quefa 预登记。Docker 中接收宿主机示例服务可使用 host.docker.internal。
DEMO_WEBHOOK_URL=http://host.docker.internal:3300/webhooks/quefa
DEMO_WEBHOOK_SECRET=replace-demo-webhook-secret
