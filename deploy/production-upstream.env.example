# Production supplier overlay. Copy values into the server-side secret environment;
# never expose this file, API keys, webhook secrets, or payment resource IDs to partners.
FULFILLMENT_PROVIDER=zovocard
ZOVOCARD_API_BASE=https://zovocard.com/openapi/v1
ZOVOCARD_CDK_BASE=https://zovocard.com/api/v1/cdk
SUPPLIER_ALLOWED_HOSTS=zovocard.com

# Set through the authenticated platform workspace or server secret store.
ZOVOCARD_API_KEY=
ZOVOCARD_WEBHOOK_SECRET=
ZOVOCARD_CARD_ID=

# Keep real submission disabled until read-only connection, catalog sync,
# webhook verification, IP allow-list, and rollback checks all pass.
LIVE_TEST_ENABLED=false
LIVE_TEST_PARTNER_IDS=
LIVE_TEST_MAX_ORDER_MINOR=16000
LIVE_TEST_MAX_TOTAL_MINOR=32000
LIVE_TEST_MAX_ORDERS=2
ZOVOCARD_CDK_FUNDING_CAP_MINOR=0
