[Unit]
Description=Verify the latest Quefa SQLite backup by isolated restore
After=quefa-backup.service

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/recharge-platform/current/deploy/production/verify-backup-restore.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
