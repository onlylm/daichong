[Unit]
Description=Back up the active Quefa SQLite application database
After=docker.service
Requires=docker.service
OnFailure=quefa-health-alert@%n.service

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/recharge-platform/current/deploy/backup-prelaunch.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
