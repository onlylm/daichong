      "html": "<div class=\"ds-tags\"><span class=\"ds-tag ds-paid\">已付款</span><span class=\"ds-tag ds-pending\">处理中</span><span class=\"ds-tag ds-review\">待核对</span></div>",
      "css": ".ds-tags{display:flex;gap:8px;flex-wrap:wrap}.ds-tag{display:inline-block;padding:3px 7px;border-radius:4px;font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei',sans-serif;font-size:11px;line-height:1.5;font-weight:550;letter-spacing:0;white-space:nowrap}.ds-paid{background:var(--ops-success-surface,#edf7f2);color:var(--mint,#19735c)}.ds-pending{background:var(--ops-warning-surface,#fff7e8);color:var(--amber,#946014)}.ds-review{background:var(--ops-danger-surface,#fff1f1);color:var(--danger-ink,#b13943)}"
    },
