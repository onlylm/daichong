      "html": "<label class=\"ds-field\">订单检索<input class=\"ds-input\" type=\"search\" placeholder=\"代理单号 / 平台单号 / 兑换码 / 充值邮箱\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei',sans-serif;font-size:12px;color:var(--secondary,#506178)}.ds-input{width:100%;min-width:0;min-height:40px;padding:9px 12px;background:var(--paper,#fff);color:var(--ink,#25364b);border:1px solid var(--line,#dce3ec);border-radius:6px;font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei',sans-serif;font-size:13px;box-shadow:none}.ds-input:focus{box-shadow:0 0 0 3px #245dcc12;border-color:var(--signal,#245dcc)}.ds-input:focus-visible{outline:3px solid #719fd9;outline-offset:4px}"
    },
    {
      "name": "主导航",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "浅蓝选中面与内侧蓝色细线标记当前位置。",
      "html": "<nav class=\"ds-nav\" aria-label=\"工作台导航预览\"><a class=\"ds-nav-link ds-nav-current\" aria-current=\"page\" href=\"#overview\">经营概览</a><a class=\"ds-nav-link\" href=\"#orders\">订单管理</a></nav>",
      "css": ".ds-nav{display:grid;gap:2px;padding:12px;background:#f8fafc;font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei',sans-serif}.ds-nav-link{display:flex;align-items:center;min-height:40px;padding:10px 12px;border-radius:6px;color:var(--secondary,#506178);font-size:13px;font-weight:550;text-decoration:none}.ds-nav-link:hover{background:#edf1f6;color:var(--night,#182b43)}.ds-nav-current,.ds-nav-current:hover{background:#e7eefb;color:var(--signal-deep,#194da9);box-shadow:inset 2px 0 var(--signal,#245dcc);font-weight:650}.ds-nav-link:focus-visible{outline:2px solid var(--signal,#245dcc);outline-offset:3px}"
    },
    {
      "name": "业务状态标签",
