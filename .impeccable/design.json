  "components": [
    {
      "name": "蓝色主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "用于当前流程的常规主操作；悬停加深，按下不位移。",
      "html": "<button type=\"button\" class=\"ds-primary\">刷新订单</button>",
      "css": ".ds-primary{min-height:40px;padding:8px 14px;border:1px solid var(--line,#dce3ec);border-radius:6px;font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei',sans-serif;font-size:13px;font-weight:600;cursor:pointer;box-shadow:none;transition:background-color .12s,border-color .12s,color .12s}.ds-primary:active{transform:none}.ds-primary:disabled{opacity:.55;cursor:not-allowed}.ds-primary:focus-visible{outline:2px solid var(--signal,#245dcc);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms}}.ds-primary{background:var(--signal,#245dcc);color:var(--paper,#fff);border-color:var(--signal,#245dcc)}.ds-primary:hover{background:var(--signal-deep,#194da9);border-color:var(--signal-deep,#194da9);color:var(--paper,#fff)}"
    },
    {
      "name": "边框次按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "用于关闭、查看与同组次要操作。",
      "html": "<button type=\"button\" class=\"ds-secondary\">查看记录</button>",
      "css": ".ds-secondary{min-height:40px;padding:8px 14px;border:1px solid var(--line,#dce3ec);border-radius:6px;font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei',sans-serif;font-size:13px;font-weight:600;cursor:pointer;box-shadow:none;transition:background-color .12s,border-color .12s,color .12s}.ds-secondary:active{transform:none}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}.ds-secondary:focus-visible{outline:2px solid var(--signal,#245dcc);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition-duration:.01ms}}.ds-secondary{background:var(--paper,#fff);color:var(--ink,#25364b)}.ds-secondary:hover{border-color:var(--signal,#245dcc);color:var(--signal,#245dcc)}"
    },
    {
      "name": "风险确认按钮",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "仅呈现风险确认外观；预览不执行交易。",
      "html": "<button type=\"button\" class=\"ds-danger\">确认退款</button>",
      "css": ".ds-danger{min-height:40px;padding:8px 14px;border:1px solid var(--line,#dce3ec);border-radius:6px;font-family:'Segoe UI','Microsoft YaHei UI','Microsoft YaHei',sans-serif;font-size:13px;font-weight:600;cursor:pointer;box-shadow:none;transition:background-color .12s,border-color .12s,color .12s}.ds-danger:active{transform:none}.ds-danger:disabled{opacity:.55;cursor:not-allowed}.ds-danger:focus-visible{outline:2px solid var(--signal,#245dcc);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-danger{transition-duration:.01ms}}.ds-danger{background:var(--danger-ink,#b13943);border-color:var(--danger-ink,#b13943);color:var(--paper,#fff)}.ds-danger:hover{background:#922831;border-color:#922831;color:var(--paper,#fff)}"
    },
    {
      "name": "带标签输入框",
      "kind": "input",
      "refersTo": "input",
