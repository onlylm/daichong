{
  "name": "quefa-open-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "account:bootstrap": "node --env-file-if-exists=.env dist/cli/bootstrap-account.js",
    "account:reset-password": "node --env-file-if-exists=.env dist/cli/reset-account-password.js",
    "account:experience": "node --env-file-if-exists=.env dist/cli/provision-experience-agent.js",
    "catalog:migrate-gpt": "node --env-file-if-exists=.env dist/cli/migrate-gpt-catalog.js",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "demo:partner": "node --env-file-if-exists=.env examples/partner-demo/server.mjs",
    "sandbox:provision": "node --env-file-if-exists=.env dist/cli/provision-sandbox-agent.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "bench:pagination": "npm run build && node scripts/benchmark-history-pagination.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-workspace-js.mjs"
  },
  "dependencies": {
    "alipay-sdk": "4.14.0",
    "fastify": "5.12.5",
    "ipaddr.js": "2.2.0",
    "pg": "8.16.3",
    "redis": "5.8.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
